---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Zone from '../components/Zone.astro';
import WorkCard from '../components/WorkCard.astro';
import { profile as p } from '../data/profile';
import { loadContent } from '../lib/content';
const { work, career, services } = await loadContent();
const short = Object.fromEntries(work.map(w => [w.id, w.data.short]));
const arrow = '↗';
---
<!doctype html>
<html lang="en">
<head><Head /></head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="helm">
    <a class="brand" translate="no" href="#surface" aria-label="amahi.dev, back to the surface"><img src="/assets/mark.svg" alt="" width="28" height="28" />amahi.dev</a>
    <div class="instruments" aria-hidden="true">
      <span class="panel sounder"><small>Depth</small> <b></b></span>
      <span class="pips"><i data-zone="0"></i><i data-zone="1"></i><i data-zone="2"></i><i data-zone="3"></i><em class="zone-name">Harbor</em></span>
    </div>
    <nav aria-label="Main"><a href="#work">Work</a><a href="#career">Career</a><a href="#server">Lab</a><span class="controls"><button class="ping" type="button" aria-keyshortcuts="P" title="Sonar ping (P)"><kbd aria-hidden="true">P</kbd><span class="word">Ping</span></button><button class="hold" type="button" aria-pressed="false" title="Pause animations"><span class="glyph" aria-hidden="true">❚❚</span><span class="word">Pause</span></button></span></nav>
    <div class="progress" aria-hidden="true"></div>
  </header>
  <div class="ruler" aria-hidden="true"><span class="you">you</span></div>
  <div class="vignette" aria-hidden="true"></div>
  <main id="main">
    <div class="traveler" aria-hidden="true">
      <div class="launch"><div class="dock-approach">
        <img class="sub" src="/assets/sub.webp" width="250" height="228" alt="" fetchpriority="high" />
      </div></div>
    </div>

    <Zone cls="surface" id="surface" depth="0 10" name="Harbor" labelledby="abrar">
      <div class="walk intro">
        <div class="surface-name">
          <p class="origin">Applied AI engineer · New York Harbor</p>
          <h1 id="abrar" class="chroma">{p.name}<span class="dot">.</span></h1>
        </div>
        <div class="surface-intro">
          <p class="lead">{p.lead}</p>
          <p>{p.intro}</p>
          <div class="manifest"><p class="manifest-title" aria-hidden="true">Dive manifest</p><dl>{p.stats.map(([n, label, to]) => <div><dt>{n}</dt><dd><a href={`#${to}`}>{label} <span aria-hidden="true">↓</span></a></dd></div>)}</dl></div>
          <div class="actions"><a class="button" href="#reef-entry">Start the dive <span aria-hidden="true">↓</span></a> <a href="#server">Skip to the lab</a></div>
        </div>
      </div>
    </Zone>

    <div class="kelp-crossing" aria-hidden="true"><img src="/assets/kelp.webp" alt="" width="96" height="123" loading="lazy" /></div>

    <Zone cls="reef" id="reef-entry" depth="10 200" name="Sunlit" labelledby="work-title" creature="turtle"
      facts={[['10 m · pressure has already doubled'], ['red light is gone by ~15 m. the sub is yellow in theory only'], ['200 m · the sunlight zone ends']]}>
      <div class="walk log" id="work">
        <p class="depth-tag">Sunlit zone · 0–200 m · Selected work</p>
        <h2 id="work-title" class="chroma">The catch<span class="dot">.</span></h2>
        <p class="chapter-intro">{p.workIntro}</p>
        <div class="work-list">{work.map(entry => <WorkCard entry={entry} />)}</div>
      </div>
    </Zone>

    <Zone cls="twilight" depth="200 1000" name="Twilight" labelledby="career-title" creature="whale"
      facts={[['332 m · deepest scuba dive on record'], ['most animals down here make their own light'], ['1,000 m · the midnight zone begins']]}>
      <div class="walk log" id="career">
        <p class="depth-tag">Twilight zone · 200–1,000 m · Career</p>
        <h2 id="career-title" class="chroma">The dive log<span class="dot">.</span></h2>
        <p class="chapter-intro">{p.careerIntro}</p>
        <div class="timeline">
          {career.map(({ data: j }) => <article><p class="mono kind">{j.dates}</p><h3 translate="no">{j.org}</h3><p class="role">{j.role}</p>{j.body && <p>{j.body}</p>}{j.proof && <p class="proof">{j.proof.map(id => <a href={`#${id}`}><span aria-hidden="true">↑ </span>{short[id]}</a>)}</p>}</article>)}
          <p class="education"><strong>{p.education[0]}</strong><br />{p.education[1]}</p>
        </div>
      </div>
    </Zone>

    <Zone cls="abyss" depth="1000 3800" name="Midnight" labelledby="server-title" creature="angler"
      facts={[['sperm whales hunt down to ~2,000 m'], ['water here holds at about 2–4 °C. good for servers'], ['the Titanic rests at 3,800 m. so does this server, more comfortably']]}>
      <div class="walk log" id="server">
        <p class="depth-tag">Midnight zone · 1,000–3,800 m · The lab</p>
        <h2 id="server-title" class="chroma">The lab at the bottom<span class="dot">.</span></h2>
        <p class="chapter-intro">{p.labIntro}</p>
        <dl class="services">{services.filter(s => !s.data.figure).map(({ data: s }) => <div><dt>{s.name}</dt><dd>{s.body}</dd></div>)}</dl>
        <p class="built" aria-hidden="true">Built down here</p>
        <dl class="services built-list">{services.filter(s => s.data.figure).map(({ id, data: s }) => <div id={id}><dt><b>{s.figure}</b> {s.name}</dt><dd>{s.body}{s.link && <><br /><a class="project-link" href={s.link.href}>{s.link.text} <span aria-hidden="true">{arrow}</span></a></>}</dd></div>)}</dl>
        <a class="project-link" href={p.lab}>Read the flake <span aria-hidden="true">{arrow}</span></a>
        <footer id="contact" class="contact">
          <h2 class="chroma">Say hello<span class="dot">.</span></h2>
          <p>{p.contact}</p>
          <div class="actions"><a class="button" href={`mailto:${p.email}`}>{p.email} <span aria-hidden="true">{arrow}</span></a></div>
          <div class="footer-links">
            <a href={p.linkedin}>LinkedIn <span aria-hidden="true">{arrow}</span></a>
            <a href={p.github}>GitHub <span aria-hidden="true">{arrow}</span></a>
            <a href="#surface">Back to surface ↑</a>
            <a href="/llms.txt">llms.txt</a>
          </div>
        </footer>
      </div>
      <Fragment slot="after">
        <div class="berth" aria-hidden="true"><img src="/assets/berth.webp" alt="" width="400" height="188" loading="lazy" /></div>
        <div class="docking-range" aria-hidden="true"></div>
      </Fragment>
    </Zone>
  </main>
  <script src="../scripts/dive.js"></script>
</body>
</html>
