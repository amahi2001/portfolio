---
import type { CollectionEntry } from 'astro:content';
// A ranked catch. The entry with a ledger is the headline feat; the rest are one-line rows.
const { entry } = Astro.props as { entry: CollectionEntry<'work'> };
const { catch: c, title, line, link, ledger } = entry.data;
---
{ledger ? (
  <article id={entry.id} class="feat">
    <p class="catch"><b>{c.approx && <i class="approx">~</i>}{c.value}</b> <span>{c.label}</span></p>
    <h3>{title}</h3>
    <ol class="strip">
      {ledger.map(r => <li><a href={r.href}><b>{r.figure}</b> {r.who} <span aria-hidden="true">↗</span></a><small>{r.note}</small></li>)}
    </ol>
    <p class="line">{line}</p>
  </article>
) : (
  <article id={entry.id} class="row">
    <p class="catch"><b>{c.approx && <i class="approx">~</i>}{c.value}</b></p>
    <div>
      <h3>{title}</h3>
      <p class="line">{line}</p>
      {link && <a class="project-link" href={link.href}>{link.text} <span aria-hidden="true">↗</span></a>}
    </div>
  </article>
)}
