{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p .vercel-redirect && echo 'Moved to https://amahi.dev/' > .vercel-redirect/index.txt",
  "outputDirectory": ".vercel-redirect",
  "redirects": [
    { "source": "/:path*", "destination": "https://amahi.dev/:path*", "permanent": true }
  ]
}
